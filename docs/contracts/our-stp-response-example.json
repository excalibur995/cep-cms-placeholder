{
  "screenId": "complete-form-example",
  "version": 1,
  "schema": {
    "type": "object",
    "properties": {
      "firstName": {
        "type": "string",
        "minLength": 2,
        "maxLength": 50,
        "messages": {
          "required": "First name is required",
          "minLength": "Minimum 2 characters"
        }
      },
      "lastName": {
        "type": "string",
        "minLength": 2,
        "maxLength": 50,
        "messages": {
          "required": "Last name is required"
        }
      },
      "emailAddress": {
        "type": "string",
        "minLength": 5,
        "maxLength": 200,
        "messages": {
          "required": "Email is required",
          "email": "Enter a valid email address",
          "minLength": "Email must be at least 5 characters",
          "maxLength": "Email must be at most 200 characters"
        }
      },
      "country": {
        "type": "string",
        "messages": {
          "required": "Please select a country"
        },
        "oneOf": [
          {
            "const": "MY",
            "title": "Malaysia"
          },
          {
            "const": "SG",
            "title": "Singapore"
          },
          {
            "const": "TH",
            "title": "Thailand"
          },
          {
            "const": "ID",
            "title": "Indonesia"
          }
        ]
      },
      "region": {
        "type": "string",
        "messages": {
          "required": "Please select a region"
        }
      },
      "city": {
        "type": "string",
        "messages": {
          "required": "Please select a city"
        }
      },
      "contactMethod": {
        "type": "string",
        "messages": {
          "required": "Please select a contact method"
        },
        "oneOf": [
          {
            "const": "email",
            "title": "Email"
          },
          {
            "const": "phone",
            "title": "Phone Call"
          },
          {
            "const": "sms",
            "title": "SMS"
          }
        ]
      },
      "phoneNumber": {
        "type": "string"
      },
      "foreignId": {
        "type": "string"
      },
      "areaCode": {
        "type": "string"
      },
      "notifications": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "oneOf": [
            {
              "const": "news",
              "title": "News & Updates"
            },
            {
              "const": "promos",
              "title": "Promotions"
            },
            {
              "const": "reminders",
              "title": "Reminders"
            }
          ]
        }
      },
      "agreeToTerms": {
        "type": "boolean",
        "messages": {
          "required": "You must agree to the terms"
        }
      },
      "promoCode": {
        "type": "string"
      },
      "discountLevel": {
        "type": "number"
      },
      "quantity": {
        "type": "number"
      },
      "verificationPin": {
        "type": "string",
        "messages": {
          "required": "Verification PIN is required"
        }
      },
      "supportingDocs": {},
      "personalData": {
        "type": "object",
        "properties": {
          "age": {
            "type": "integer",
            "messages": {
              "required": "Please enter your age"
            }
          },
          "height": {
            "type": "number",
            "messages": {
              "required": "Please enter your height"
            }
          },
          "drivingSkill": {
            "type": "number"
          }
        },
        "required": ["age", "height"]
      }
    },
    "required": [
      "firstName",
      "lastName",
      "emailAddress",
      "country",
      "region",
      "city",
      "contactMethod",
      "agreeToTerms",
      "verificationPin"
    ]
  },
  "uiSchema": {
    "header": {
      "type": "VerticalLayout",
      "elements": [
        {
          "component": "TopNavigation",
          "options": {
            "id": "properties.topNav",
            "title": "Complete Form Example",
            "disableSafeArea": false
          }
        },
        {
          "component": "Typo",
          "options": {
            "id": "properties.screenTitle",
            "variant": "title2",
            "value": "All Conditions Demo",
            "textAlign": "center"
          }
        },
        {
          "component": "Typo",
          "options": {
            "id": "properties.screenSubtitle",
            "variant": "body",
            "value": "Fill in all fields below",
            "textAlign": "center"
          }
        }
      ]
    },
    "body": {
      "type": "VerticalLayout",
      "elements": [
        {
          "type": "HorizontalLayout",
          "elements": [
            {
              "component": "TextInput",
              "options": {
                "id": "properties.firstName",
                "placeholder": "Enter first name",
                "disabled": false
              },
              "label": "First Name"
            },
            {
              "component": "TextInput",
              "options": {
                "id": "properties.lastName",
                "placeholder": "Enter last name",
                "disabled": false
              },
              "label": "Last Name"
            }
          ]
        },
        {
          "component": "TextInput",
          "options": {
            "id": "properties.emailAddress",
            "placeholder": "Enter your email",
            "disabled": false
          },
          "label": "Email Address",
          "dynamic": {
            "id": 29,
            "enabled": true,
            "type": "VALUE",
            "target": "defaultValue",
            "source": {
              "id": 29,
              "type": "FACT",
              "path": "userEmail",
              "serviceCode": null
            }
          }
        },
        {
          "component": "Dropdown",
          "options": {
            "id": "properties.country",
            "placeholder": "Select your country",
            "disabled": false
          },
          "label": "Country"
        },
        {
          "component": "Dropdown",
          "options": {
            "id": "properties.region",
            "placeholder": "Select your region",
            "disabled": false,
            "dataSource": {
              "url": "/api/ref/regions/:country",
              "depends": "country",
              "responseMap": {
                "valueKey": "code",
                "labelKey": "name"
              }
            }
          },
          "label": "Region"
        },
        {
          "component": "Dropdown",
          "options": {
            "id": "properties.city",
            "placeholder": "Select your city",
            "disabled": false,
            "dataSource": {
              "url": "/api/ref/cities/:region",
              "depends": "region",
              "responseMap": {
                "valueKey": "code",
                "labelKey": "name"
              }
            }
          },
          "label": "City"
        },
        {
          "component": "RadioButton",
          "options": {
            "id": "properties.contactMethod",
            "groupDirection": "vertical",
            "disabled": false
          },
          "label": "Preferred Contact Method"
        },
        {
          "component": "TextInput",
          "options": {
            "id": "properties.phoneNumber",
            "placeholder": "+60 12 345 6789",
            "disabled": false
          },
          "label": "Phone Number",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/contactMethod",
              "schema": {
                "const": "phone"
              }
            }
          }
        },
        {
          "component": "TextInput",
          "options": {
            "id": "properties.foreignId",
            "placeholder": "Enter foreign identification number",
            "disabled": false
          },
          "label": "Foreign ID Number",
          "rule": {
            "effect": "HIDE",
            "condition": {
              "scope": "#/properties/country",
              "schema": {
                "const": "MY"
              }
            }
          }
        },
        {
          "component": "SearchInput",
          "options": {
            "id": "properties.areaCode",
            "placeholder": "Search area code",
            "disabled": false
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/contactMethod",
              "schema": {
                "enum": ["phone", "sms"]
              }
            }
          }
        },
        {
          "component": "Checkbox",
          "options": {
            "id": "properties.notifications",
            "disabled": false
          },
          "label": "Notification Preferences"
        },
        {
          "component": "Toggle",
          "options": {
            "id": "properties.agreeToTerms",
            "size": "md",
            "disabled": false
          }
        },
        {
          "component": "TextInput",
          "options": {
            "id": "properties.promoCode",
            "placeholder": "Enter promo code (optional)",
            "disabled": false
          },
          "label": "Promo Code",
          "rule": {
            "effect": "ENABLE",
            "condition": {
              "scope": "#/properties/agreeToTerms",
              "schema": {
                "const": true
              }
            }
          }
        },
        {
          "component": "Button",
          "options": {
            "id": "properties.promoInfoBtn",
            "variant": "tertiary",
            "size": "sm",
            "disabled": false,
            "loading": false,
            "action": {
              "type": "show_modal",
              "payload": {
                "overlayId": "promoInfo"
              }
            }
          },
          "label": "What is a promo code?"
        },
        {
          "component": "Slider",
          "options": {
            "id": "properties.discountLevel",
            "min": 0,
            "max": 100,
            "step": 10
          },
          "label": "Discount Level (%)",
          "rule": {
            "effect": "DISABLE",
            "condition": {
              "scope": "#/properties/agreeToTerms",
              "schema": {
                "const": false
              }
            }
          }
        },
        {
          "component": "NumberInputStepper",
          "options": {
            "id": "properties.quantity",
            "min": 1,
            "max": 99,
            "step": 1,
            "editable": true
          },
          "label": "Quantity"
        },
        {
          "component": "PinInput",
          "options": {
            "id": "properties.verificationPin",
            "numberOfDigits": 6,
            "inputMode": "numeric",
            "secureTextEntry": false,
            "autoFocus": false
          }
        },
        {
          "component": "Uploader",
          "options": {
            "id": "properties.supportingDocs",
            "maxFiles": 3,
            "maxFileSizeBytes": 5242880,
            "autoUpload": false,
            "disabled": false
          }
        },
        {
          "component": "NumberInputStepper",
          "options": {
            "id": "properties.personalData.properties.age",
            "min": 18,
            "max": 99,
            "step": 1,
            "editable": true
          },
          "label": "Age"
        },
        {
          "component": "NumberInputStepper",
          "options": {
            "id": "properties.personalData.properties.height",
            "min": 50,
            "max": 250,
            "step": 1,
            "editable": true
          },
          "label": "Height (cm)"
        },
        {
          "component": "Slider",
          "options": {
            "id": "properties.personalData.properties.drivingSkill",
            "min": 1,
            "max": 10,
            "step": 1
          },
          "label": "Driving Skill"
        },
        {
          "component": "Button",
          "options": {
            "id": "properties.leaveBtn",
            "variant": "secondary",
            "size": "md",
            "disabled": false,
            "loading": false,
            "action": {
              "type": "show_modal",
              "payload": {
                "overlayId": "confirmLeave"
              }
            }
          },
          "label": "Leave Application"
        }
      ]
    },
    "footer": {
      "type": "VerticalLayout",
      "elements": [
        {
          "component": "Button",
          "options": {
            "id": "properties.submitButton",
            "variant": "primary",
            "size": "lg",
            "disabled": false,
            "loading": false,
            "action": {
              "type": "submit"
            }
          },
          "label": "Submit"
        }
      ]
    }
  },
  "data": {
    "firstName": "",
    "lastName": "",
    "emailAddress": "",
    "country": "",
    "region": "",
    "city": "",
    "contactMethod": "",
    "phoneNumber": "",
    "foreignId": "",
    "areaCode": "",
    "notifications": [],
    "agreeToTerms": "",
    "promoCode": "",
    "discountLevel": "",
    "quantity": "",
    "verificationPin": "",
    "supportingDocs": "",
    "personalData": {
      "age": "",
      "height": "",
      "drivingSkill": ""
    }
  }
}
